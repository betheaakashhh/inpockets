APP_NAME=InPockets API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SMS_PROVIDER=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inpockets
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
OTP_HASH_SECRET=change-me-otp-secret

# OTP verification abuse protection
OTP_VERIFY_LIMIT=20
OTP_VERIFY_WINDOW_SECONDS=900

# Twilio testing provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 production provider
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_SENDER_ID=

# E-sign (development provider verifies HMAC-signed callbacks with this secret)
ESIGN_PROVIDER=development
ESIGN_WEBHOOK_SECRET=
ESIGN_VALIDITY_HOURS=72
ESIGN_REQUIRE_SIGNED_ARTIFACT=true

# Bank verification + field encryption
# Generate a key:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BANK_VERIFICATION_PROVIDER=development
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
BANK_FINGERPRINT_KEY=
BANK_VERIFICATION_MAX_ATTEMPTS_PER_DAY=5
BANK_VERIFICATION_PENDING_TIMEOUT_HOURS=24

# Reverse proxy / rate limiting
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=600

# Disbursement
DISBURSEMENT_PROVIDER=development
DISBURSEMENT_WEBHOOK_SECRET=
DISBURSEMENT_RECONCILE_GRACE_MINUTES=10
DISBURSEMENT_MAX_UNRESOLVED_HOURS=24
