APP_NAME=InPockets API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SMS_PROVIDER=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inpockets
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
OTP_HASH_SECRET=change-me-otp-secret

# OTP verification abuse protection
OTP_VERIFY_LIMIT=20
OTP_VERIFY_WINDOW_SECONDS=900

# Twilio testing provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 production provider
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_SENDER_ID=
